# Copy to `.env` (git-ignored). Vite exposes only VITE_-prefixed vars to the client.
# NEVER put private keys or secrets here — this file ships to the browser.

# --- GenLayer / Studionet chain ---------------------------------------------
# Fill these from the GenLayer docs for the network you target.
VITE_CHAIN_ID=61999                      # GenLayer Studionet chain id
VITE_CHAIN_NAME=GenLayer Studionet
VITE_RPC_URL=https://studio.genlayer.com/api
VITE_EXPLORER_URL=https://genlayer-explorer.vercel.app
VITE_NATIVE_SYMBOL=GEN
VITE_NATIVE_DECIMALS=18

# --- WalletConnect ----------------------------------------------------------
# Get a projectId at https://cloud.walletconnect.com (public, safe to expose).
VITE_WALLETCONNECT_PROJECT_ID=

# --- Target contract (optional; used by the Action Hub) ---------------------
# AIPatentGuard on Studionet (fresh deployment 2026-08-23). Replace with your
# own deployed instance as needed.
#
# OPTIONAL: if unset, the app falls back to a bundled default deployment
# (see DEFAULT_CONTRACT_ADDRESS in src/lib/contract.ts) and users can override
# it at runtime via the Action Hub's "Target contract" panel.
#
# On Vercel, local .env files are NOT read — set this in
# Project Settings -> Environment Variables (name: VITE_CONTRACT_ADDRESS) so it
# is inlined into the client bundle at build time.
VITE_CONTRACT_ADDRESS=0x032fd9BD3b79178A26e1872F1e214BD4b16bD23b
